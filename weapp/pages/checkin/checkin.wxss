.page { display: flex; flex-direction: column; height: 100vh; background: #000; }
.header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12px 16px; background: #0f172a;
}
.header-left { display: flex; align-items: center; gap: 10px; }
.course-name { font-size: 1.1rem; font-weight: 700; }
.live-tag {
  display: flex; align-items: center; gap: 4px;
  padding: 3px 10px; border-radius: 12px;
  background: rgba(16,185,129,0.15); color: #10b981;
  font-size: 0.75rem; font-weight: 600;
}
.dot {
  width: 6px; height: 6px; border-radius: 50%; background: #10b981;
  animation: pulse 1.5s infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
.header-right .count { font-size: 1.2rem; font-weight: 800; color: #6ee7b7; }
.camera-wrapper {
  position: relative; width: 100%; height: 55vh;
  background: #000; overflow: hidden;
}
.camera-preview { width: 100%; height: 100%; object-fit: cover; }
.face-canvas {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
}

/* 摄像头状态叠加 */
.camera-overlay {
  position: absolute; top: 10px; left: 10px; right: 10px;
  display: flex; justify-content: space-between; pointer-events: none;
}
.overlay-status {
  background: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 8px;
  font-size: 0.75rem; font-weight: 600;
}
.overlay-status.active { color: #10b981; }
.overlay-status.idle { color: #94a3b8; }
.overlay-speed {
  background: rgba(0,0,0,0.6); padding: 4px 10px; border-radius: 8px;
  font-size: 0.7rem; color: #94a3b8;
}

.result-list { flex: 1; background: #0f172a; overflow: hidden; }
.result-scroll {
  height: 100%; padding: 8px 16px;
}
.face-item {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 12px; margin-bottom: 4px;
  background: rgba(255,255,255,0.03); border-radius: 10px;
}
.face-avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: #10b981; display: flex; align-items: center;
  justify-content: center; font-size: 1rem; font-weight: 700;
  color: #fff; flex-shrink: 0;
}
.face-info { flex: 1; }
.face-name { font-size: 0.95rem; font-weight: 600; }
.face-name.unknown { color: #94a3b8; }
.face-status { font-size: 0.8rem; font-weight: 600; }
.face-status.success { color: #10b981; }
.face-status.fail { color: #ef4444; }
.recognizing-hint { text-align: center; padding: 8px; color: #64748b; font-size: 0.85rem; }

.actions {
  display: flex; gap: 12px; padding: 12px 16px;
  background: #0f172a; border-top: 1px solid #1e293b;
}
.actions .btn { flex: 1; }
