# Copy to .env and replace every <...> value. Never commit .env.
MYSQL_DATABASE=<database-name>
MYSQL_USER=<database-user>
MYSQL_PASSWORD=<database-password>
MYSQL_ROOT_PASSWORD=<mysql-root-password>
REDIS_PASSWORD=<redis-password>
RECOGNITION_SHARED_TOKEN=<high-entropy-internal-token>
DASHBOARD_TOKEN=<high-entropy-dashboard-token>
FLASK_SECRET_KEY=<legacy-flask-session-secret>
SERVER_NAME=<public-dns-name>
TLS_CERT_PATH=<absolute-path-to-fullchain-pem>
TLS_KEY_PATH=<absolute-path-to-private-key-pem>

# Keep false until a controlled per-client compatibility rollout is approved.
COMPATIBILITY_ENABLED=false
REALTIME_ENABLED=false

# The standard upstream is Spring. For rollback, start the rollback profile and
# set PUBLIC_UPSTREAM=legacy-flask:8090.
PUBLIC_UPSTREAM=business-service:8081
LEGACY_FLASK_IMAGE=classroom-face-checkin-legacy:local
LEGACY_DATA_PATH=../data
LEGACY_WORKSPACE_PATH=../work_space
